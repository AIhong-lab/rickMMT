{
  "name": "rickmmt-autopost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute rickmmt-autopost --file=./schema.sql --remote",
    "db:init-local": "wrangler d1 execute rickmmt-autopost --file=./schema.sql --local",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
